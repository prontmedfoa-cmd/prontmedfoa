<%- include('../layouts/header') %>

<%- include('../layouts/sidebar') %>

<div class="container mt-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h2>Novo Paciente</h2>
            <p class="text-muted">Registre um novo paciente para iniciar o prontuário.</p>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <form id="patientForm">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nome Completo</label>
                        <input name="full_name" class="form-control" placeholder="Nome Completo" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">CPF</label>
                        <input name="cpf" class="form-control" placeholder="CPF" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Data de Nascimento</label>
                        <input name="birth_date" class="form-control" type="date" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Telefone</label>
                        <input name="phone" class="form-control" placeholder="Telefone" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Email</label>
                        <input name="email" class="form-control" type="email" placeholder="Email" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Tipo Sanguíneo</label>
                        <input name="blood_type" class="form-control" placeholder="Ex: O+" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Alergias</label>
                        <input name="allergies" class="form-control" placeholder="Alergias" />
                    </div>
                </div>
                <div class="mt-4">
                    <button type="submit" class="btn btn-success">Salvar</button>
                </div>
            </form>
        </div>
    </div>

</div>

<script src="/js/patient-create.js"></script>

<%- include('../layouts/footer') %>