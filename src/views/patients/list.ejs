<%- include('../layouts/header') %>

<%- include('../layouts/sidebar') %>

<div class="container-fluid mt-3">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h2>Pacientes</h2>
            <p class="text-muted">Gerencie os registros dos pacientes com atenção e clareza.</p>
        </div>
        <a href="/patients/new" class="btn btn-primary">Novo Paciente</a>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="row g-3 mb-4">
                <div class="col-md-5">
                    <input id="searchName" class="form-control" placeholder="Nome" />
                </div>
                <div class="col-md-5">
                    <input id="searchCpf" class="form-control" placeholder="CPF" />
                </div>
                <div class="col-md-2 d-grid">
                    <button id="btnSearch" class="btn btn-primary">Buscar</button>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nome</th>
                            <th>CPF</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody id="patientsTable"></tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<script src="/js/patients.js"></script>

<%- include('../layouts/footer') %>