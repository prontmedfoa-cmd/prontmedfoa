<%- include('../layouts/header') %>

<%- include('../layouts/sidebar') %>

<div class="container mt-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h2>Editar Paciente</h2>
            <p class="text-muted">Atualize os dados do paciente sempre que necessário.</p>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <form id="patientEditForm">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nome Completo</label>
                        <input name="full_name" class="form-control" placeholder="Nome Completo" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">CPF</label>
                        <input name="cpf" class="form-control" placeholder="CPF" disabled />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Telefone</label>
                        <input name="phone" class="form-control" placeholder="Telefone" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Email</label>
                        <input name="email" class="form-control" type="email" placeholder="Email" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Tipo Sanguíneo</label>
                        <input name="blood_type" class="form-control" placeholder="Ex: O+" />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">Alergias</label>
                        <input name="allergies" class="form-control" placeholder="Alergias" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Endereço</label>
                        <input name="address_street" class="form-control mb-3" placeholder="Rua" />
                        <div class="row g-3">
                            <div class="col-md-3">
                                <input name="address_number" class="form-control" placeholder="Número" />
                            </div>
                            <div class="col-md-3">
                                <input name="address_complement" class="form-control" placeholder="Complemento" />
                            </div>
                            <div class="col-md-3">
                                <input name="address_district" class="form-control" placeholder="Bairro" />
                            </div>
                            <div class="col-md-3">
                                <input name="address_zipcode" class="form-control" placeholder="CEP" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">Atualizar</button>
                </div>
            </form>
        </div>
    </div>

</div>

<script src="/js/patient-edit.js"></script>

<%- include('../layouts/footer') %>