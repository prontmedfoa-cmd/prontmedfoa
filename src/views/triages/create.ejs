<%- include('../layouts/header') %>

<%- include('../layouts/sidebar') %>

<div class="container mt-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h2>Nova Triagem</h2>
            <p class="text-muted">Registre os sinais vitais do paciente com cuidado e clareza.</p>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <form id="triageForm">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Paciente</label>
                        <select id="patientSelect" name="patient_id" class="form-control" required></select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">ID do Agendamento</label>
                        <input id="appointmentId" name="appointment_id" type="number" class="form-control" placeholder="Número do agendamento" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Classificação de risco</label>
                        <select id="riskClassificationSelect" name="risk_classification_id" class="form-control" required></select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Pressão Arterial</label>
                        <input name="blood_pressure" class="form-control" placeholder="120/80" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Glicemia</label>
                        <input name="glucose_level" type="number" step="0.1" class="form-control" placeholder="mg/dL" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Peso (kg)</label>
                        <input name="weight" type="number" step="0.1" class="form-control" placeholder="Peso" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Altura (m)</label>
                        <input name="height" type="number" step="0.01" class="form-control" placeholder="Altura" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Escala de dor</label>
                        <input name="pain_scale" type="number" min="0" max="10" class="form-control" placeholder="0-10" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Temperatura (°C)</label>
                        <input name="temperature" type="number" step="0.1" class="form-control" placeholder="Temperatura" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Frequência Cardíaca</label>
                        <input name="heart_rate" type="number" class="form-control" placeholder="BPM" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Frequência Respiratória</label>
                        <input name="respiratory_rate" type="number" class="form-control" placeholder="RPM" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Saturação de O₂</label>
                        <input name="oxygen_saturation" type="number" class="form-control" placeholder="%" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Queixa Principal</label>
                        <textarea name="chief_complaint" class="form-control" rows="3" placeholder="Descreva a queixa principal" required></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Observações</label>
                        <textarea name="observations" class="form-control" rows="4" placeholder="Observações adicionais"></textarea>
                    </div>
                </div>
                <div class="mt-4">
                    <button type="submit" class="btn btn-success">Salvar Triagem</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="/js/triages.js"></script>

<%- include('../layouts/footer') %>