<%- include('../layouts/header') %>

<%- include('../layouts/sidebar') %>

<div class="container-fluid mt-3">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h2>Triagens</h2>
            <p class="text-muted">Selecione um paciente para visualizar as triagens recentes e registrar novos atendimentos.</p>
        </div>
        <a href="/triages/new" class="btn btn-primary">Nova Triagem</a>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label">Paciente</label>
                    <select id="patientSelect" class="form-control"></select>
                </div>
                <div class="col-md-3 d-grid">
                    <button id="btnLoadTriages" class="btn btn-primary">Buscar triagens</button>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Paciente</th>
                            <th>Data</th>
                            <th>Classificação</th>
                            <th>Pressão</th>
                            <th>Peso</th>
                            <th>Altura</th>
                        </tr>
                    </thead>
                    <tbody id="triagesTable"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="/js/triages.js"></script>

<%- include('../layouts/footer') %>