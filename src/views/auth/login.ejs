<%- include('../layouts/auth-header', { title: 'Login | Prontuário Eletrônico' }) %>

<div class="auth-page">
    <div class="auth-card">
        <h2>Bem-vindo</h2>
        <p class="text-muted mb-4">Acesse o sistema com sua conta e continue cuidando de quem precisa.</p>
        <form id="loginForm">
            <input class="form-control mb-3" type="email" id="email" placeholder="Email" required />
            <input class="form-control mb-3" type="password" id="password" placeholder="Senha" required />
            <button class="btn btn-primary" type="submit">Entrar</button>
        </form>
    </div>
</div>

<script src="/js/auth.js"></script>

<%- include('../layouts/footer') %>